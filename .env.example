# Google Gemini Free API Key (from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gmail SMTP Settings for Human-Approved Sending
GMAIL_USER=your_email@gmail.com
# Use a 16-character App Password generated at: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=your_16_character_app_password

# Optional Model Configuration (default: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite
